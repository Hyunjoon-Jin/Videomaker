  {
   "poly": "창덕궁",
   "id": "wga_11109014_001",
   "ce": 1465,
   "king": "세조",
   "yr": 11,
   "mo": "9",
   "dy": 14,
   "label": "창덕궁 후원",
   "say": "임금이 소식을 듣고 북악산까지 올라가 표범을 잡음",
   "han": "上聞虎入昌德宮後苑, 遂幸北岳, 獲豹而還。",
   "ko": "임금이 범이 창덕궁(昌德宮) 후원(後苑)에 들어왔다는 말을 듣고 드디어 북악(北岳)에 가서 표범을 잡고 돌아왔다.",
   "full": "上聞虎入昌德宮後苑, 遂幸北岳, 獲豹而還。",
   "key": "虎入昌德宮後苑",
   "x": 433.9,
   "y": 541.4,
   "cam": {
    "cx": 416.9,
